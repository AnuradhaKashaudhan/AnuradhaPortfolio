# Portfolio Client Environment Variables
# Copy this file to .env and fill in the values

# API base URL (leave empty for same-origin proxy)
VITE_API_URL=

# EmailJS (optional client-side alternative)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Analytics
VITE_GA_MEASUREMENT_ID=

# Google reCAPTCHA v3 site key (optional in development)
VITE_RECAPTCHA_SITE_KEY=your-google-recaptcha-v3-site-key
