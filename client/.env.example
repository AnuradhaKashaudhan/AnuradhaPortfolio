# Portfolio Client Environment Variables
# Copy this file to .env and fill in the values

# Leave empty to use the Vite proxy in development or the same-origin server in production.
VITE_API_URL=

# EmailJS (optional client-side alternative)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Analytics
VITE_GA_MEASUREMENT_ID=

# Google reCAPTCHA v3 site key (optional in development)
VITE_RECAPTCHA_SITE_KEY=your-google-recaptcha-v3-site-key
