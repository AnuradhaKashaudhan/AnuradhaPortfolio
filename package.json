{
  "name": "portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Anuradha Kashaudhan – Developer Portfolio Monorepo",
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
