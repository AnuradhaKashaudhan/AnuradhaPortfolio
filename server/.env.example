# Portfolio Server Environment Variables
# Copy this file to .env and fill in the values

PORT=3001
NODE_ENV=development

# CORS - the frontend origin (comma separated origins are supported)
CLIENT_ORIGIN=http://localhost:5173

# Email (Nodemailer SMTP)
SMTP_SERVICE=gmail
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
TO_EMAIL=your-inbox@example.com
FROM_NAME=Anuradha Kashaudhan
# Optional Resend alternative. If set, it takes precedence over SMTP.
RESEND_API_KEY=
FROM_EMAIL=Portfolio <onboarding@resend.dev>
RECAPTCHA_SECRET_KEY=your-google-recaptcha-v3-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GITHUB_USERNAME=your-github-username
# Optional, increases GitHub API rate limits
GITHUB_TOKEN=
